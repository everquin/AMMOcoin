# AMMOcoin RPC connection
AMMOCOIN_RPC_URL=http://localhost:51473
AMMOCOIN_RPC_USER=gateway
AMMOCOIN_RPC_PASSWORD=your_rpc_password_here

# Payment gateway settings
INVOICE_EXPIRY_MINUTES=30
REQUIRED_CONFIRMATIONS=6
POLL_INTERVAL_MS=15000

# SQLite database path (relative to project root)
DATABASE_PATH=./data/gateway.db

# Webhook settings
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_RETRIES=5

# Payout settings (outbound sends, e.g. "sell Nuggets for AMMO")
# Passphrase to unlock an ENCRYPTED hot wallet for each send. Strongly
# recommended: encrypt the gateway wallet and set this. Leave empty only if
# the wallet is unencrypted (not advised for a funded hot wallet).
GATEWAY_WALLET_PASSPHRASE=
# Per-payout ceiling (AMMO) — blast-radius limit if a merchant key leaks.
MAX_PAYOUT_AMMO=100000
# Dust floor (AMMO) — reject sub-fee payouts.
MIN_PAYOUT_AMMO=0.0001
