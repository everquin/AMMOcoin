#!/bin/sh
# ammocoin-node-cli: run ammocoin-cli against the packaged ammocoind service
# (user "ammocoin", data folder /var/lib/ammocoin/.ammocoincore). Example:
#   ammocoin-node-cli getblockcount
# Plain `ammocoin-cli` talks to a node run by *your* user (~/.ammocoincore) instead.
SVC_USER=ammocoin
SVC_HOME=/var/lib/ammocoin
DATADIR=$SVC_HOME/.ammocoincore

if [ "$(id -un)" = "$SVC_USER" ]; then
  HOME=$SVC_HOME exec /usr/bin/ammocoin-cli -datadir="$DATADIR" "$@"
elif [ "$(id -u)" = 0 ] && command -v runuser >/dev/null 2>&1; then
  exec runuser -u "$SVC_USER" -- env HOME="$SVC_HOME" /usr/bin/ammocoin-cli -datadir="$DATADIR" "$@"
else
  exec sudo -u "$SVC_USER" env HOME="$SVC_HOME" /usr/bin/ammocoin-cli -datadir="$DATADIR" "$@"
fi
