# AMMOcoin Explorer Configuration
# Copy this file to .env.local and update with your settings

# AMMOcoin RPC Configuration
# AMMOcoin v1.1.0 Mainnet RPC Port: 51473
AMMOCOIN_RPC_URL=http://localhost:51473
AMMOCOIN_RPC_USER=explorer
AMMOCOIN_RPC_PASSWORD=secure_password_here

# Explorer Configuration
NEXT_PUBLIC_EXPLORER_NAME="AMMOcoin Explorer"
NEXT_PUBLIC_NETWORK_NAME="AMMOcoin Mainnet"
NEXT_PUBLIC_COIN_SYMBOL="AMMO"

# No price or market-data API: the explorer shows no price, market cap or fiat value
# for AMMO (docs/compliance AMMO-P-03, AMMO-D-2026-10-17-09).

# Optional: Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Optional: Site Configuration
NEXT_PUBLIC_SITE_URL=https://explorer.ammocoin.org
NEXT_PUBLIC_SITE_DESCRIPTION="AMMOcoin Blockchain Explorer - Explore blocks, transactions, and addresses on the AMMOcoin network"

# Development Settings (remove in production)
NODE_ENV=development